# Copy to .env.local and fill in from Supabase → Project Settings → API. Never commit .env.local.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Only for the local seed script. Never prefix with VITE_, never put in GitHub.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
